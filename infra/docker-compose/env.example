# ══════════════════════════════════════════════════════════════════════════
# MyCodeXvantaOS — Environment Variables Template
# Copy this file to .env and fill in the values for your deployment.
# ══════════════════════════════════════════════════════════════════════════

# ── General ──────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug

# ── Database (PostgreSQL) ───────────────────────────────────────────────
DATABASE_URL=postgres://mycodexvantaos:mycodexvantaos@localhost:5432/mycodexvantaos

# ── Cache (Redis / Cloudflare KV) ────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Object Storage (MinIO / Cloudflare R2) ──────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=mycodexvantaos
MINIO_SECRET_KEY=mycodexvantaos-secret
MINIO_BUCKET=mycodexvantaos-storage
MINIO_USE_SSL=false

# ── Vector Search (Qdrant / Cloudflare Vectorize) ───────────────────────
QDRANT_URL=http://localhost:6333

# ── Message Queue (RabbitMQ / Cloudflare Queues) ────────────────────────
RABBITMQ_URL=amqp://mycodexvantaos:mycodexvantaos@localhost:5672

# ── Authentication ───────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-secure-random-string
ENCRYPTION_KEY=change-me-in-production-32ch

# ── Model Providers (API Keys) ──────────────────────────────────────────
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# ── Cloudflare Bindings (for production Worker deployment) ──────────────
# D1_DATABASE_ID=
# KV_CACHE_NAMESPACE_ID=
# KV_SESSION_NAMESPACE_ID=
# R2_BUCKET_NAME=mycodexvantaos-storage
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
