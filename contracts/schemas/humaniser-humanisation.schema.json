{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:mycodexvantaos:schema:humaniser-humanisation",
  "title": "HumaniserHumanisationResult",
  "description": "Schema for AI Humaniser humanisation/rewrite result validation",
  "type": "object",
  "required": [
    "id",
    "humanisedText",
    "sentenceRewrites",
    "changeSummary",
    "updatedDetection",
    "comparison",
    "timestamp",
    "providerSource",
    "processingTimeMs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique result identifier"
    },
    "humanisedText": {
      "type": "string",
      "minLength": 1,
      "description": "The humanised text output"
    },
    "sentenceRewrites": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/SentenceRewrite"
      },
      "description": "Per-sentence rewrite results"
    },
    "changeSummary": {
      "$ref": "#/definitions/ChangeSummary"
    },
    "updatedDetection": {
      "$ref": "humaniser-detection.schema.json#/definitions/DetectionResult"
    },
    "comparison": {
      "$ref": "#/definitions/SideBySideComparison"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp"
    },
    "providerSource": {
      "type": "string",
      "enum": ["native", "external", "hybrid"],
      "description": "Provider source used"
    },
    "processingTimeMs": {
      "type": "number",
      "minimum": 0,
      "description": "Processing time in milliseconds"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "SentenceRewrite": {
      "type": "object",
      "required": ["index", "original", "rewritten", "originalAiScore", "newAiScore", "improvement", "changes"],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "description": "Original sentence index"
        },
        "original": {
          "type": "string",
          "description": "Original sentence text"
        },
        "rewritten": {
          "type": "string",
          "description": "Rewritten sentence text"
        },
        "originalAiScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Original AI score"
        },
        "newAiScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "New AI score after rewrite"
        },
        "improvement": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Score improvement"
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of specific changes made"
        }
      },
      "additionalProperties": false
    },
    "ChangeSummary": {
      "type": "object",
      "required": ["sentencesRewritten", "sentencesUnchanged", "avgScoreImprovement", "overallScoreChange", "changeCategories"],
      "properties": {
        "sentencesRewritten": {
          "type": "integer",
          "minimum": 0
        },
        "sentencesUnchanged": {
          "type": "integer",
          "minimum": 0
        },
        "avgScoreImprovement": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "overallScoreChange": {
          "type": "object",
          "required": ["before", "after"],
          "properties": {
            "before": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "after": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        },
        "changeCategories": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ChangeCategory"
          }
        }
      },
      "additionalProperties": false
    },
    "ChangeCategory": {
      "type": "object",
      "required": ["category", "count", "examples"],
      "properties": {
        "category": {
          "type": "string",
          "enum": ["formality", "ai-pattern-removal", "sentence-structure", "hedging", "sentence-opening", "vocabulary", "other"]
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 3
        }
      },
      "additionalProperties": false
    },
    "SideBySideComparison": {
      "type": "object",
      "required": ["originalHighlighted", "humanisedHighlighted", "diffs"],
      "properties": {
        "originalHighlighted": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/HighlightedSegment"
          }
        },
        "humanisedHighlighted": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/HighlightedSegment"
          }
        },
        "diffs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DiffSegment"
          }
        }
      },
      "additionalProperties": false
    },
    "HighlightedSegment": {
      "type": "object",
      "required": ["text", "label", "confidence", "index"],
      "properties": {
        "text": {
          "type": "string"
        },
        "label": {
          "type": "string",
          "enum": ["ai", "human", "mixed", "uncertain"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "index": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "DiffSegment": {
      "type": "object",
      "required": ["type", "index"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["added", "removed", "unchanged"]
        },
        "original": {
          "type": "string"
        },
        "humanised": {
          "type": "string"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}
