{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:mycodexvantaos:schema:policy-decision",
  "title": "PolicyDecision",
  "description": "Result of a policy evaluation — allow or deny with reasoning",
  "type": "object",
  "properties": {
    "allowed": {
      "type": "boolean"
    },
    "effect": {
      "type": "string",
      "enum": ["allow", "deny"]
    },
    "reason": {
      "type": "string"
    },
    "rule_id": {
      "type": "string",
      "description": "The policy rule that made the decision"
    },
    "role": {
      "type": "string",
      "enum": [
        "platform-admin",
        "workspace-owner",
        "workspace-member",
        "workspace-viewer",
        "agent-service",
        "auditor"
      ]
    },
    "scope": {
      "type": "string",
      "enum": ["platform", "workspace"]
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "status": { "type": "string", "enum": ["True", "False", "Unknown"] },
          "reason": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": ["allowed", "effect", "reason", "role"],
  "additionalProperties": false
}
