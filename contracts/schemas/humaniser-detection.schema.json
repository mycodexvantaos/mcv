{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:mycodexvantaos:schema:humaniser-detection",
  "title": "HumaniserDetectionResult",
  "description": "Schema for AI content detection results from the Humaniser engine",
  "type": "object",
  "required": [
    "id",
    "label",
    "confidence",
    "ai_score",
    "human_score",
    "sentences",
    "stats",
    "explanation",
    "timestamp",
    "provider_source"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique detection result identifier"
    },
    "label": {
      "type": "string",
      "enum": ["ai", "human", "mixed", "uncertain"],
      "description": "Overall classification label"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Overall confidence score for the assigned label"
    },
    "ai_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "AI probability score (0-1, higher = more AI-like)"
    },
    "human_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Human probability score (0-1, higher = more human-like)"
    },
    "sentences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text",
          "index",
          "label",
          "confidence",
          "ai_score",
          "human_score",
          "features",
          "explanation"
        ],
        "properties": {
          "text": { "type": "string" },
          "index": { "type": "integer", "minimum": 0 },
          "label": {
            "type": "string",
            "enum": ["ai", "human", "mixed", "uncertain"]
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "ai_score": { "type": "number", "minimum": 0, "maximum": 1 },
          "human_score": { "type": "number", "minimum": 0, "maximum": 1 },
          "features": {
            "type": "object",
            "properties": {
              "avg_word_length": { "type": "number" },
              "word_count": { "type": "integer" },
              "lexical_diversity": { "type": "number" },
              "avg_word_frequency": { "type": "number" },
              "punctuation_density": { "type": "number" },
              "complexity": { "type": "number" },
              "repetition_score": { "type": "number" },
              "perplexity_proxy": { "type": "number" },
              "transition_smoothness": { "type": "number" },
              "vocabulary_richness": { "type": "number" }
            }
          },
          "explanation": { "type": "string" }
        }
      }
    },
    "stats": {
      "type": "object",
      "required": [
        "total_sentences",
        "ai_sentences",
        "human_sentences",
        "uncertain_sentences",
        "avg_confidence"
      ],
      "properties": {
        "total_sentences": { "type": "integer" },
        "ai_sentences": { "type": "integer" },
        "human_sentences": { "type": "integer" },
        "uncertain_sentences": { "type": "integer" },
        "avg_confidence": { "type": "number" },
        "max_ai_score": { "type": "number" },
        "min_ai_score": { "type": "number" },
        "std_dev_ai_score": { "type": "number" }
      }
    },
    "explanation": {
      "type": "string",
      "description": "Human-readable explanation of the overall detection result"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "provider_source": {
      "type": "string",
      "enum": ["native", "external", "hybrid"],
      "description": "Which provider was used for the detection"
    },
    "processing_time_ms": {
      "type": "integer",
      "description": "Processing time in milliseconds"
    }
  }
}
