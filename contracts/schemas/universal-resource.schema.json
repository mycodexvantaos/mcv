{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:mycodexvantaos:schema:universal-resource",
  "title": "UniversalResource",
  "description": "MyCodexVantaOS universal resource envelope — every resource on the platform follows this shape",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "pattern": "^platform\\.mycodexvantaos/v\\d+$",
      "description": "API version of this resource"
    },
    "kind": {
      "type": "string",
      "enum": [
        "IdentitySubject",
        "Workspace",
        "Document",
        "DocumentChunk",
        "KnowledgeCollection",
        "KnowledgeIndex",
        "RetrievalReceipt",
        "AnswerTrace",
        "MemoryItem",
        "KnowledgeIssue",
        "KnowledgeRepair",
        "KnowledgeDerivedArtifact",
        "ChatSession",
        "ModelEndpoint",
        "AuditEvent",
        "UsageRecord"
      ],
      "description": "Resource kind from the platform kind registry"
    },
    "metadata": {
      "$ref": "#/definitions/ResourceMetadata"
    },
    "spec": {
      "type": "object",
      "description": "Resource-specific specification — validated per-kind"
    },
    "status": {
      "$ref": "#/definitions/ResourceStatus"
    }
  },
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "definitions": {
    "ResourceMetadata": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Globally unique resource identifier"
        },
        "urn": {
          "type": "string",
          "pattern": "^urn:mycodexvantaos:[a-z]+:[a-z-]+:[a-f0-9-]+$",
          "description": "Platform URN following urn:mycodexvantaos:{group}:{kind}:{id}"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "description": {
          "type": "string",
          "maxLength": 2048
        },
        "workspace_id": {
          "type": "string",
          "format": "uuid"
        },
        "owner_id": {
          "type": "string",
          "format": "uuid"
        },
        "labels": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "maxProperties": 20
        },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "maxProperties": 50
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "deleted_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": ["id", "urn", "workspace_id", "created_at"]
    },
    "ResourceStatus": {
      "type": "object",
      "properties": {
        "phase": {
          "type": "string",
          "description": "Current lifecycle phase"
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ResourceCondition"
          }
        },
        "observed_generation": {
          "type": "integer"
        }
      }
    },
    "ResourceCondition": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "status": { "type": "string", "enum": ["True", "False", "Unknown"] },
        "reason": { "type": "string" },
        "message": { "type": "string" },
        "last_transition_time": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "status"]
    }
  }
}
