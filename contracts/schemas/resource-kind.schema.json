{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ResourceKind",
  "type": "object",
  "properties": {
    "apiVersion": { "type": "string" },
    "kind": { "type": "string" },
    "metadata": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "namespace": { "type": "string" },
        "labels": { "type": "object" },
        "annotations": { "type": "object" }
      },
      "required": ["name"]
    },
    "spec": { "type": "object" },
    "status": { "type": "object" }
  },
  "required": ["apiVersion", "kind", "metadata", "spec"]
}
