  "dependencies": {
    "@mycodexvantaos/core": "workspace:*",
    "@mycodexvantaos/ports": "workspace:*",
    "@mycodexvantaos/application": "workspace:*",
    "@mycodexvantaos/adapters": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0"
  },
