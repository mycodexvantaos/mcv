{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mycodexvantaos.io/schemas/unified-gates/usage-event",
  "title": "Usage Event",
  "description": "Schema for AI workload usage events.",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "type": "string",
      "enum": ["inference-usage", "training-usage", "embedding-usage", "agent-run-usage"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "workloadId": {
      "type": "string"
    },
    "workspaceId": {
      "type": "string"
    },
    "projectId": {
      "type": "string"
    },
    "billingAccountId": {
      "type": "string"
    },
    "modelId": {
      "type": "string"
    },
    "usageMetrics": {
      "type": "object",
      "properties": {
        "inputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "gpuHours": {
          "type": "number",
          "minimum": 0
        },
        "latencyMs": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "required": [
    "eventId",
    "eventType",
    "timestamp",
    "workloadId",
    "workspaceId",
    "projectId",
    "billingAccountId",
    "modelId",
    "usageMetrics"
  ],
  "additionalProperties": false
}
