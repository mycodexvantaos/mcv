{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mycodexvantaos.io/schemas/unified-gates/ai-workload-contract",
  "title": "AI Workload Contract",
  "description": "Schema for AI workload contract definitions.",
  "type": "object",
  "properties": {
    "workloadId": {
      "type": "string"
    },
    "workloadType": {
      "type": "string",
      "enum": ["inference", "training", "embedding", "rag", "agent-run"]
    },
    "namespace": {
      "type": "string",
      "enum": ["mycodexvantaos", "softwareos"]
    },
    "modelRef": {
      "type": "string"
    },
    "resourceLimits": {
      "type": "object",
      "properties": {
        "cpu": {
          "type": "string"
        },
        "memory": {
          "type": "string"
        },
        "gpu": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["cpu", "memory"]
    },
    "slo": {
      "type": "object",
      "properties": {
        "maxLatencyMs": {
          "type": "integer",
          "minimum": 1
        },
        "minAvailability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": ["maxLatencyMs", "minAvailability"]
    },
    "billingAccountId": {
      "type": "string"
    },
    "workspaceId": {
      "type": "string"
    },
    "projectId": {
      "type": "string"
    }
  },
  "required": [
    "workloadId",
    "workloadType",
    "namespace",
    "modelRef",
    "resourceLimits",
    "slo",
    "billingAccountId",
    "workspaceId",
    "projectId"
  ],
  "additionalProperties": false
}
