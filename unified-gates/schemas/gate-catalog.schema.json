{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mycodexvantaos.io/schemas/unified-gates/gate-catalog",
  "title": "Gate Catalog",
  "description": "Schema for gate catalog YAML files.",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "ssot": {
          "type": "boolean"
        },
        "authority": {
          "type": "string"
        },
        "governanceCode": {
          "type": "string",
          "pattern": "^mycodexvantaos-[0-9]{5}$"
        }
      },
      "required": ["name", "version", "authority", "governanceCode"]
    },
    "spec": {
      "type": "object",
      "properties": {
        "planes": {
          "type": "array"
        },
        "gates": {
          "type": "array"
        },
        "evidencePolicy": {
          "type": "object"
        },
        "lifecycleStages": {
          "type": "array"
        }
      }
    }
  },
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false
}
