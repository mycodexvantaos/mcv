{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mycodexvantaos.io/schemas/unified-gates/ai-infra-gate",
  "title": "AI Infrastructure Gate",
  "description": "Schema for AI infrastructure gate definitions (alias of gate.schema.json).",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "mycodexvantaos.io/v1"
    },
    "kind": {
      "type": "string",
      "const": "AIInfraGate"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^gate-[0-9]{2}-[a-z0-9-]+$"
        },
        "version": {
          "type": "string"
        },
        "layer": {
          "type": "string",
          "enum": ["l00", "l10", "l20", "l30", "l40", "l50", "l60", "l90"]
        },
        "plane": {
          "type": "string",
          "enum": ["ai-infra", "quality", "production"]
        },
        "blocking": {
          "type": "boolean"
        },
        "lifecycle": {
          "type": "string",
          "enum": ["proposed", "active", "deprecated", "archived", "destroyed"]
        },
        "criticality": {
          "type": "string",
          "enum": ["critical", "high", "medium", "low"]
        },
        "owner": {
          "type": "string"
        },
        "governanceCode": {
          "type": "string",
          "pattern": "^mycodexvantaos-[0-9]{5}$"
        }
      },
      "required": [
        "id",
        "version",
        "layer",
        "plane",
        "blocking",
        "lifecycle",
        "owner",
        "governanceCode"
      ]
    },
    "spec": {
      "type": "object",
      "required": ["description", "validates"]
    }
  },
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false
}
