# CI Repair Agent — Environment Configuration
# Copy this file to .env and fill in the values

# GitHub token with repo and actions scope
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub repository (owner/repo format)
GITHUB_REPOSITORY=mycodexvantaos/mycodexvantaos

# PostgreSQL connection URL
DATABASE_URL=postgresql://ci_repair:ci_repair_secret@localhost:5432/ci_repair

# PostgreSQL password (used by docker-compose)
POSTGRES_PASSWORD=ci_repair_secret

# PostgreSQL port (used by docker-compose)
POSTGRES_PORT=5432

# Application settings
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
