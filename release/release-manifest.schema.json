{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mycodexvantaos.io/schemas/release-manifest.schema.json",
  "title": "ReleaseManifest",
  "description": "Schema for MyCodeXvantaOS release manifest. Generated at build time and served via GET /v1/version and GET /v1/runtime.",
  "type": "object",
  "required": ["version", "commit", "branch", "buildTimestamp", "runtime", "manifestHash"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "description": "Semantic version of the release (e.g. '0.1.0')",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9.]+)?$"
    },
    "commit": {
      "type": "string",
      "description": "Git commit SHA of the release"
    },
    "branch": {
      "type": "string",
      "description": "Git branch the release was built from"
    },
    "buildTimestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of when the release was built"
    },
    "runtime": {
      "type": "object",
      "description": "Runtime environment details",
      "required": ["nodeVersion", "platform", "arch"],
      "additionalProperties": false,
      "properties": {
        "nodeVersion": {
          "type": "string",
          "description": "Node.js version (e.g. 'v22.0.0')"
        },
        "platform": {
          "type": "string",
          "description": "OS platform (e.g. 'linux', 'darwin')"
        },
        "arch": {
          "type": "string",
          "description": "CPU architecture (e.g. 'x64', 'arm64')"
        }
      }
    },
    "services": {
      "type": "array",
      "description": "List of included services",
      "items": {
        "type": "object",
        "required": ["name", "version"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "hash": {
            "type": "string",
            "description": "SHA-256 hash of the service package for integrity verification"
          }
        }
      }
    },
    "governance": {
      "type": "object",
      "description": "Governance enforcement status",
      "additionalProperties": false,
      "properties": {
        "auditEnforcement": {
          "type": "boolean"
        },
        "knowledgeTraceEnforcement": {
          "type": "boolean"
        },
        "dreamSafetyEnforcement": {
          "type": "boolean"
        }
      }
    },
    "manifestHash": {
      "type": "string",
      "description": "SHA-256 hash of the entire manifest (excluding manifestHash itself) for integrity verification",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
