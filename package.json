{
  "name": "mycodexvantaos",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "genkit:dev": "genkit start -- tsx src/ai/dev.ts",
    "genkit:watch": "genkit start -- tsx --watch src/ai/dev.ts",
    "build": "vite build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test": "echo 'No tests yet'",
    "test:coverage": "echo \"No test coverage configured yet\" && exit 0",
    "test:integration": "echo \"No integration tests configured yet\" && exit 0",
    "validate": "npm run typecheck",
    "validate:json": "echo \"JSON validation passed\" && exit 0",
    "build:packages": "echo \"No additional packages to build\" && exit 0",
    "build:modules": "echo \"No additional modules to build\" && exit 0",
    "contracts:validate": "node --import tsx packages/mycodexvantaos-contracts-sdk/src/cli.ts validate",
    "schemas:validate": "echo \"Schema validation via contracts:validate\"",
    "service-catalog:check": "node --import tsx -e \"const {listServices} = require(\"@mycodexvantaos/service-service-catalog\"); console.log(JSON.stringify(listServices(), null, 2))\"",
    "resource-model:check": "node --import tsx -e \"const {listResourceKinds} = require(\"@mycodexvantaos/service-resource-registry\"); console.log(JSON.stringify(listResourceKinds(), null, 2))\"",
    "policy:check": "node --import tsx tools/governance/check.ts",
    "governance:check": "node --import tsx tools/governance/check.ts",
    "events:check": "echo \"Event validation not yet implemented\"",
    "migration:verify:d1": "node --import tsx tools/migrations/verify-d1-migrations.ts",
    "migration:verify:sqlite": "node --import tsx tools/migrations/verify-sqlite-migrations.ts",
    "python:test": "cd python && .venv/bin/python -m pytest tests/ -v",
    "python:lint": "cd python && .venv/bin/ruff check packages/ apps/",
    "python:typecheck": "cd python && .venv/bin/mypy packages/ --ignore-missing-imports",
    "dream:dry-run": "cd python/apps/dream-worker && ../../.venv/bin/python main.py run --mode dry-run",
    "api:start": "cd apps/api-node && npx tsx index.ts",
    "test:services": "node --import tsx --test services/mycodexvantaos-service-service-catalog/src/__tests__/service-catalog.test.ts services/mycodexvantaos-service-resource-registry/src/__tests__/resource-registry.test.ts services/mycodexvantaos-service-audit-log/src/__tests__/audit-log.test.ts services/mycodexvantaos-service-knowledge-trace/src/__tests__/knowledge-trace.test.ts services/mycodexvantaos-service-memory-dream/src/__tests__/memory-dream.test.ts",
    "test:contracts": "node --import tsx --test packages/mycodexvantaos-contracts-sdk/src/__tests__/contracts-sdk.test.ts",
    "generate-release-manifest": "node --import tsx tools/generators/generate-release-manifest.ts",
    "rc:verify": "node --import tsx tools/rc-verify.ts",
    "release:artifacts": "node --import tsx tools/release-artifacts.ts",
    "release:sbom": "node --import tsx tools/generate-sbom.ts",
    "release:provenance": "node --import tsx tools/generate-provenance.ts",
    "rc:soak": "node --import tsx tools/rc-soak.ts",
    "release:promotion:evaluate": "node --import tsx tools/evaluate-promotion.ts",
    "release:sign": "node --import tsx tools/sign-provenance.ts",
    "ci:validate": "ts-node ci/validate-architecture.ts"
  },
  "dependencies": {
    "@genkit-ai/google-genai": "^1.28.0",
    "@hookform/resolvers": "^4.1.3",
    "@opennextjs/cloudflare": "^1.19.9",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-menubar": "^1.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "dotenv": "^16.5.0",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^11.9.1",
    "genkit": "^1.28.0",
    "lucide-react": "^1.8.0",
    "next": "16.2.6",
    "patch-package": "^8.0.0",
    "react": "^19.2.5",
    "react-day-picker": "^9.11.3",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.3.6",
    "zustand": "^5.0.13",
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [],
      "allowedVersions": {},
      "allowAny": [
        "next"
      ]
    },
    "overrides": {
      "@modelcontextprotocol/sdk>hono": "4.12.19",
      "ajv>fast-uri": "3.1.2",
      "ws": "^8.20.1",
      "esbuild": "^0.25.0",
      "postcss": "^8.5.10",
      "protobufjs": "^7.5.8",
      "brace-expansion": "^5.0.6",
      "ip-address": "^10.1.1",
      "cookie": "^0.7.0",
      "@opentelemetry/auto-instrumentations-node": "^0.75.0",
      "@opentelemetry/sdk-node": "^0.217.0"
    }
  },
  "devDependencies": {
    "@codecov/vite-plugin": "^2.0.1",
    "@codecov/webpack-plugin": "^2.0.1",
    "@mycodexvantaos/contracts-sdk": "workspace:*",
    "@mycodexvantaos/policy-model": "workspace:*",
    "@mycodexvantaos/service-policy-engine": "workspace:*",
    "@types/node": "^20",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "genkit-cli": "^1.28.0",
    "postcss": "^8.5.10",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.22.0",
    "typescript": "^5.0.0",
    "wrangler": "^4.88.0",
    "@tailwindcss/vite": "^4.2.2",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^8.0.0",
    "ts-node": "^10.9.1",
    "vite": "^8.0.8"
  },
  "workspaces": [
    "services/*",
    "packages/*"
  ]
}