{
  "name": "mycodexvantaos",
  "version": "1.0.0",
  "description": "MyCodexVantaOS — AI-era upstream software infrastructure platform",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:unit": "pnpm -r run test:unit",
    "test:integration": "pnpm -r run test:integration",
    "test:e2e": "pnpm -r run test:e2e",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r run typecheck",
    "validate:architecture": "ts-node ci/validate-architecture.ts",
    "validate:naming": "python3 scripts/validate-naming.py",
    "validate:governance": "python3 scripts/validate-namespace-governance.py",
    "validate:gates": "python3 unified-gates/scripts/validate-ai-infra-gates.py",
    "validate:all": "pnpm run validate:architecture && pnpm run validate:naming && pnpm run validate:governance && pnpm run validate:gates",
    "ci:gates": "pnpm run validate:all && pnpm run test",
    "generate:reports": "pnpm run generate:architecture-report && pnpm run generate:gates-report",
    "generate:architecture-report": "python3 scripts/generate-architecture-validation-report.py",
    "generate:gates-report": "python3 unified-gates/scripts/generate-gate-report.py",
    "dev": "pnpm -r run dev",
    "clean": "pnpm -r run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "pnpm": {
    "overrides": {
      "semver": ">=7.5.2"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mycodexvantaos/mycodexvantaos.git"
  },
  "homepage": "https://mycodexvantaos.com",
  "bugs": {
    "url": "https://github.com/mycodexvantaos/mycodexvantaos/issues"
  }
}
