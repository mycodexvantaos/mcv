{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mycodexvantaos.io/schemas/namespace-registry-record",
  "title": "Namespace Registry Record",
  "description": "JSON Schema for MyCodexVantaOS namespace registry records (I.11.2)",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "mycodexvantaos.io/v1"
    },
    "kind": {
      "type": "string",
      "const": "NamespaceRegistryRecord"
    },
    "metadata": {
      "type": "object",
      "required": ["id", "organization"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?:mycodexvantaos|softwareos)-[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Registry record ID matching repository naming pattern (I.6.2)"
        },
        "organization": {
          "type": "string",
          "const": "mycodexvantaos"
        }
      }
    },
    "spec": {
      "type": "object",
      "required": ["namespace", "domain", "function", "repository", "lifecycle"],
      "properties": {
        "namespace": {
          "type": "string",
          "enum": ["mycodexvantaos", "softwareos"],
          "description": "Namespace plane (I.2.1)"
        },
        "domain": {
          "type": "string",
          "enum": [
            "auth", "policy", "memory", "event", "infra", "platform",
            "iaops", "machinenativeops", "toolkit", "contracts", "signerd",
            "controller", "rolloutd", "db-schemas", "autotask", "compliance",
            "prediction", "qa", "rollback", "scheduler", "alertd"
          ],
          "description": "Controlled domain vocabulary (I.7.2)"
        },
        "function": {
          "type": "string",
          "enum": [
            "service", "agent", "sdk", "cli", "web", "api", "worker",
            "manager", "hub", "bus", "engine", "scanner", "reporter",
            "predictor", "action", "plugin", "controller", "repository"
          ],
          "description": "Controlled function vocabulary (I.7.3)"
        },
        "repository": {
          "type": "string",
          "pattern": "^(?:mycodexvantaos|softwareos)-[a-z0-9]+(?:-[a-z0-9]+)*-[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Repository name matching canonical pattern (I.6.2)"
        },
        "governanceCode": {
          "type": "string",
          "pattern": "^mycodexvantaos-[0-9]{5}$",
          "description": "Governance code (I.3.2)"
        },
        "era": {
          "type": "string",
          "enum": ["meta-governance", "era-one", "era-two", "era-three", "cross-era-governance"],
          "description": "Governance era (I.4.1)"
        },
        "lifecycle": {
          "type": "string",
          "enum": ["proposed", "active", "deprecated", "archived", "destroyed"],
          "description": "Lifecycle stage (I.10.1)"
        },
        "owner": {
          "type": "string",
          "description": "Owning team or role"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "enum": ["proposed", "active", "deprecated", "archived", "destroyed"]
        }
      }
    }
  }
}
