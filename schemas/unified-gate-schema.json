{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Unified Gate Definition Schema",
  "type": "object",
  "required": ["id", "plane", "lifecycle", "blocking", "layer", "owner"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^gate-[0-9]{2}-[a-z0-9-]+$"
    },
    "plane": {
      "type": "string",
      "enum": ["quality", "ai-infra", "quality-gate-plane", "ai-infra-gate-plane"]
    },
    "lifecycle": {
      "type": "string",
      "enum": ["proposed", "active", "deprecated", "archived"]
    },
    "blocking": {
      "type": "boolean"
    },
    "layer": {
      "type": "string",
      "enum": [
        "meta-governance",
        "compute-foundation",
        "data-foundation",
        "algorithm-foundation",
        "ai-workload",
        "ai-task-billing",
        "cloud-managed-infrastructure",
        "attestation-compliance-closure"
      ]
    },
    "owner": {
      "type": "string",
      "format": "email"
    },
    "contract": {
      "type": "object",
      "properties": {
        "input": { "type": "array" },
        "validation_logic": { "type": "array" },
        "output": { "type": "array" }
      }
    },
    "validates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dimension": { "type": "string" },
          "description": { "type": "string" },
          "checks": { "type": "array" }
        }
      }
    },
    "evidence_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string" }
        }
      }
    }
  }
}
