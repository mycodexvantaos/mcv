{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mycodexvantaos.com/schemas/capability-set.schema.json",
  "title": "CapabilitySet",
  "description": "Schema for MyCodexVantaOS capability set",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "capabilities"],
  "properties": {
    "apiVersion": { "type": "string", "const": "mycodexvantaos.org/v1" },
    "kind": { "type": "string", "const": "CapabilitySet" },
    "metadata": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "authoritative": { "type": "boolean" }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "category"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "description": { "type": "string" },
          "category": {
            "type": "string",
            "enum": [
              "data",
              "security",
              "messaging",
              "platform",
              "ai",
              "quantum",
              "devops",
              "governance",
              "infra"
            ]
          },
          "providers": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "minItems": 24,
      "maxItems": 30
    },
    "validation": {
      "type": "object",
      "properties": {
        "capability-name-pattern": { "type": "string" },
        "forbidden-vendor-prefixes": { "type": "array", "items": { "type": "string" } },
        "total-count": { "type": "integer", "minimum": 24, "maximum": 30 }
      }
    }
  }
}
