{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mycodexvantaos.com/schemas/audit-chain.schema.json",
  "title": "AuditChain",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "chain-id": {
      "type": "string",
      "description": "Unique chain identifier"
    },
    "platform": {
      "type": "string",
      "const": "mycodexvantaos"
    },
    "created-at": {
      "type": "string",
      "format": "date-time"
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "https://mycodexvantaos.com/schemas/audit-event.schema.json"
      },
      "minItems": 0
    },
    "head-hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "Hash of the most recent event"
    },
    "event-count": {
      "type": "integer",
      "minimum": 0
    },
    "integrity-verified": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "type",
    "timestamp",
    "chain-id",
    "platform",
    "created-at",
    "events",
    "head-hash"
  ],
  "description": "MyCodexVantaOS audit chain schema — immutable linked event chain",
  "additionalProperties": false
}
